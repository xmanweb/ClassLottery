<?xml version="1.0" encoding="utf-8"?>
<LinearLayout android:background="#F8F9FA" android:gravity="center_horizontal" android:layout_height="match_parent" android:layout_width="match_parent" android:orientation="vertical" android:padding="16dp" xmlns:android="http://schemas.android.com/apk/res/android">

    <Button android:id="@+id/btnSelectFolder" android:layout_height="wrap_content" android:layout_width="wrap_content" android:text="📁 选择照片文件夹 (.png)"/>

    <ImageView android:background="#FFFFFF" android:id="@+id/imgResult" android:layout_height="280dp" android:layout_marginTop="16dp" android:layout_width="220dp" android:scaleType="centerInside"/>

    <TextView android:id="@+id/tvResultId" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:layout_width="wrap_content" android:text="学号: --" android:textColor="#0066CC" android:textSize="18sp"/>

    <TextView android:id="@+id/tvResultName" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:layout_width="wrap_content" android:text="姓名: ---" android:textColor="#333333" android:textSize="18sp"/>

    <TextView android:id="@+id/tvResultTitle" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:layout_width="wrap_content" android:text android:textColor="#E67E22" android:textSize="14sp"/>

    <LinearLayout android:gravity="center" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:layout_width="match_parent" android:orientation="horizontal">

        <Button android:backgroundTint="#4CAF50" android:id="@+id/btnStart" android:layout_height="wrap_content" android:layout_width="wrap_content" android:text="▶ 开始抽取" android:textColor="#FFFFFF"/>

        <Button android:backgroundTint="#F44336" android:enabled="false" android:id="@+id/btnStop" android:layout_height="wrap_content" android:layout_marginStart="16dp" android:layout_width="wrap_content" android:text="🎯 停止/揭晓" android:textColor="#FFFFFF"/>
    </LinearLayout>
</LinearLayout>

